#!/usr/bin/env bash

set -Eeuo pipefail

readonly REPO_DIR=/home/paulning/work/scx
readonly SERVICE=scx.service
readonly SERVICE_UNIT_SOURCE="$REPO_DIR/services/scx.service"
readonly SERVICE_UNIT_INSTALL=/etc/systemd/system/scx.service
readonly LOGROTATE_SOURCE="$REPO_DIR/services/scx.logrotate"
readonly LOGROTATE_INSTALL=/etc/logrotate.d/scx

scheduler=cosmos
profile=release

if (( $# > 2 )); then
    echo "Usage: $(basename "$0") [cosmos|layered] [debug|release|release-fast]" >&2
    exit 2
fi

if (( $# >= 1 )); then
    case "$1" in
        cosmos|layered)
            scheduler="$1"
            ;;
        debug|release|release-fast)
            # Backward compatibility: `scx-cosmos-redeploy debug` still
            # means a debug build of COSMOS.
            profile="$1"
            ;;
        *)
            echo "Usage: $(basename "$0") [cosmos|layered] [debug|release|release-fast]" >&2
            exit 2
            ;;
    esac
fi

if (( $# == 2 )); then
    profile="$2"
fi

case "$scheduler" in
    cosmos)
        package=scx_cosmos
        install_path=/usr/local/bin/scx_cosmos
        service_config="$REPO_DIR/services/scx"
        expected_ops=cosmos
        config_source=
        config_install_path=
        ;;
    layered)
        package=scx_layered
        install_path=/usr/local/bin/scx_layered
        service_config="$REPO_DIR/services/scx-layered"
        expected_ops=layered
        config_source="$REPO_DIR/configs/scx-layered-7900x.json"
        config_install_path=/etc/scx/scx-layered-7900x.json
        ;;
esac

case "$profile" in
    debug)
        cargo_profile_args=()
        binary_path="$REPO_DIR/target/debug/$package"
        ;;
    release)
        cargo_profile_args=(--release)
        binary_path="$REPO_DIR/target/release/$package"
        ;;
    release-fast)
        cargo_profile_args=(--profile release-fast)
        binary_path="$REPO_DIR/target/release-fast/$package"
        ;;
    *)
        echo "Usage: $(basename "$0") [cosmos|layered] [debug|release|release-fast]" >&2
        exit 2
        ;;
esac

echo "==> Repository: $REPO_DIR"
echo "==> Scheduler: $scheduler"
echo "==> Build profile: $profile"
cd "$REPO_DIR"

# Build first so a compiler error does not interrupt the currently running
# scheduler. release is the default because debug builds distort benchmarks.
cargo build --locked -p "$package" "${cargo_profile_args[@]}"
test -x "$binary_path"
"$binary_path" --version

if [[ -n "$config_source" ]]; then
    test -r "$config_source"
    "$binary_path" --print-and-exit "f:$config_source" >/dev/null
    echo "==> Validated config: $config_source"
fi

echo "==> Installing systemd and logrotate configuration"
sudo -n install -d -m 0755 /var/log/scx
sudo -n install -m 0644 "$SERVICE_UNIT_SOURCE" "$SERVICE_UNIT_INSTALL"
sudo -n install -m 0644 "$LOGROTATE_SOURCE" "$LOGROTATE_INSTALL"
sudo -n systemctl daemon-reload

echo "==> Stopping $SERVICE"
sudo -n systemctl stop "$SERVICE"

if sudo -n test -x "$install_path"; then
    echo "==> Saving the previous binary as ${install_path}.previous"
    sudo -n install -m 0755 "$install_path" "${install_path}.previous"
fi

echo "==> Installing $binary_path -> $install_path"
sudo -n install -m 0755 "$binary_path" "$install_path"

if [[ -n "$config_source" ]]; then
    echo "==> Installing $config_source -> $config_install_path"
    sudo -n install -D -m 0644 "$config_source" "$config_install_path"
fi

echo "==> Selecting $scheduler in /etc/default/scx"
sudo -n install -m 0644 "$service_config" /etc/default/scx

echo "==> Restarting $SERVICE"
sudo -n systemctl reset-failed "$SERVICE"
sudo -n systemctl restart "$SERVICE"

# systemd may report the process as active slightly before the BPF struct_ops
# link has finished attaching, so verify both states for up to five seconds.
for _ in {1..20}; do
    service_state="$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    scx_state="$(cat /sys/kernel/sched_ext/state 2>/dev/null || true)"
    ops="$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true)"
    if [[ "$service_state" == active && "$scx_state" == enabled && "$ops" == "$expected_ops"* ]]; then
        echo "==> SUCCESS"
        echo "    target: $scheduler"
        echo "    service: $service_state"
        echo "    sched_ext: $scx_state"
        echo "    scheduler: $ops"
        echo "    binary: $install_path"
        echo "    log: /var/log/scx/scx.log"
        if [[ -n "$config_install_path" ]]; then
            echo "    config: $config_install_path"
        fi
        exit 0
    fi
    sleep 0.25
done

echo "==> FAILED: $SERVICE did not attach $scheduler" >&2
echo "    service: ${service_state:-unknown}" >&2
echo "    sched_ext: ${scx_state:-unknown}" >&2
echo "    scheduler: ${ops:-none}" >&2
sudo -n systemctl status "$SERVICE" --no-pager -l || true
sudo -n journalctl -u "$SERVICE" -n 80 --no-pager || true
exit 1
